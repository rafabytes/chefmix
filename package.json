{
  "name": "chefmix-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Tema WordPress do ChefMix — WordPress + Parcel + TailwindCSS + Swup + React",
  "scripts": {
    "dev": "parcel watch src/js/main.jsx --target theme --no-hmr --no-cache",
    "build": "npm run clean && parcel build src/js/main.jsx --target theme --no-cache --no-source-maps",
    "clean": "node -e \"for (const d of ['dist','.parcel-cache']) require('fs').rmSync(d,{recursive:true,force:true})\""
  },
  "targets": {
    "theme": {
      "distDir": "dist",
      "context": "browser",
      "outputFormat": "global",
      "publicUrl": "./",
      "includeNodeModules": true,
      "engines": {
        "browsers": [
          "> 0.5%",
          "last 2 versions",
          "not dead"
        ]
      }
    }
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "devDependencies": {
    "parcel": "^2.12.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.1.0",
    "@swup/a11y-plugin": "^5.0.0",
    "@swup/body-class-plugin": "^3.3.0",
    "@swup/head-plugin": "^2.3.0",
    "@swup/preload-plugin": "^3.2.0",
    "@swup/scroll-plugin": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swup": "^4.10.0"
  }
}
